#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  python_cmd="python3"
elif command -v python >/dev/null 2>&1; then
  python_cmd="python"
elif command -v py >/dev/null 2>&1; then
  python_cmd="py -3"
else
  echo "Pre-push security scan cannot run: Python 3 was not found. Run scripts/setup.ps1 first." >&2
  exit 1
fi

# Scan both the outgoing repository history and the current worktree.  The
# hook fails closed so a missing scanner cannot silently bypass the policy.
if [ "$python_cmd" = "py -3" ]; then
  set -- py -3 "$repo_root/scripts/check_sensitive.py" --history
else
  set -- "$python_cmd" "$repo_root/scripts/check_sensitive.py" --history
fi
"$@"
