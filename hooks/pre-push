#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$repo_root/scripts/check_sensitive.py" --repo "$repo_root" --pre-push
elif command -v python >/dev/null 2>&1; then
  exec python "$repo_root/scripts/check_sensitive.py" --repo "$repo_root" --pre-push
elif command -v py >/dev/null 2>&1; then
  exec py -3 "$repo_root/scripts/check_sensitive.py" --repo "$repo_root" --pre-push
fi

echo "Pre-push safety gate cannot run: Python 3 was not found." >&2
exit 1
